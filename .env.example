TV_API_URL=https://nexastream-tv.onrender.com
DASHBOARD_PUBLIC_URL=https://your-real-dashboard-host.example
# For local testing, supply the TV service's ADMIN_API_KEY in your shell (never commit it).
TV_ADMIN_API_KEY=paste-your-existing-tv-service-admin-key-here
DASHBOARD_PASSWORD=set-a-different-random-operator-password-at-least-32-characters
DASHBOARD_SESSION_SECRET=set-another-random-session-secret-at-least-32-characters
# Optional ONLY when running on loopback: omit DASHBOARD_PASSWORD, set
# DASHBOARD_PASSWORDLESS_LOCAL=true, and use DASHBOARD_PUBLIC_URL=http://127.0.0.1:8000